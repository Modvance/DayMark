{
  "name": "daymark-desktop",
  "productName": "Daymark",
  "version": "0.5.1",
  "description": "本地桌面日程与截止日期管理",
  "author": "Daymark",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:win:linux": "node scripts/build-windows-linux.cjs",
    "release:win": "npm test && npm run preview && npm run dist:win && node scripts/verify-release.cjs",
    "verify:release": "node scripts/verify-release.cjs",
    "preview": "node scripts/build-preview.cjs"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.0.12",
    "jsdom": "30.1.3",
    "pe-library": "0.4.1",
    "resedit": "1.7.2"
  },
  "build": {
    "appId": "com.daymark.desktop",
    "productName": "Daymark",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "src/native/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/icon.ico",
      "executableName": "Daymark",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Daymark-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daymark",
      "uninstallDisplayName": "Daymark",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "include": "build/installer.nsh"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Modvance/DayMark.git"
  },
  "homepage": "https://github.com/Modvance/DayMark#readme",
  "bugs": {
    "url": "https://github.com/Modvance/DayMark/issues"
  }
}
